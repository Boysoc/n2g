---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const pagePath = (page: number) => (page === 1 ? '/' : `/posts/${page}/`);
---

{totalPages > 1 && (
  <nav class="pagination-wrapper" aria-label="文章分页">
    {currentPage > 1 ? (
      <a href={pagePath(currentPage - 1)} class="pagination-edge" rel="prev" aria-label="上一页">
        <span class="tri-left" aria-hidden="true"></span>
      </a>
    ) : (
      <span class="pagination-edge is-disabled" aria-hidden="true">
        <span class="tri-left" aria-hidden="true"></span>
      </span>
    )}

    {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
      <a
        href={pagePath(page)}
        class:list={{ active: page === currentPage }}
        aria-label={`第 ${page} 页`}
        aria-current={page === currentPage ? 'page' : undefined}
      >
        {page}
      </a>
    ))}

    {currentPage < totalPages ? (
      <a href={pagePath(currentPage + 1)} class="pagination-edge" rel="next" aria-label="下一页">
        <span class="tri-right" aria-hidden="true"></span>
      </a>
    ) : (
      <span class="pagination-edge is-disabled" aria-hidden="true">
        <span class="tri-right" aria-hidden="true"></span>
      </span>
    )}
  </nav>
)}
