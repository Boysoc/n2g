---
import "@waline/client/waline.css";
---

<div class="waline-container" data-waline-root aria-busy="false">
  <div class="waline-status" data-waline-status>评论将在接近这里时自动加载</div>
  <div class="waline-mount" data-waline-mount></div>
</div>

<script>
  import type { WalineInstance } from "@waline/client";

  let walineInstance: WalineInstance | null = null;
  let clientPromise: Promise<typeof import("@waline/client")> | null = null;
  let commentsObserver: IntersectionObserver | null = null;
  let navigationVersion = 0;

  function normalizedPath() {
    const pathname = window.location.pathname;
    return pathname.endsWith("/") ? pathname : `${pathname}/`;
  }

  function loadWalineClient() {
    if (!clientPromise) {
      clientPromise = import("@waline/client").catch((error) => {
        clientPromise = null;
        throw error;
      });
    }
    return clientPromise;
  }

  function setStatus(
    root: HTMLElement,
    state: "idle" | "loading" | "error" | "ready",
  ) {
    const status = root.querySelector<HTMLElement>("[data-waline-status]");
    if (!status) return;
    root.dataset.state = state;
    root.setAttribute("aria-busy", state === "loading" ? "true" : "false");
    status.hidden = state === "ready";
    if (state === "loading") status.textContent = "正在加载评论…";
    if (state === "error") {
      status.innerHTML =
        '评论加载失败，请检查网络后 <button type="button" data-waline-retry>重新加载</button>';
    }
  }

  function addServerHint() {
    if (document.querySelector("link[data-waline-preconnect]")) return;
    const link = document.createElement("link");
    link.rel = "preconnect";
    link.href = "https://tencent.n2g.cn";
    link.crossOrigin = "anonymous";
    link.dataset.walinePreconnect = "true";
    document.head.appendChild(link);
  }

  async function mountWaline(root: HTMLElement, version: number) {
    if (root.dataset.state === "loading" || root.dataset.state === "ready")
      return;
    const mount = root.querySelector<HTMLElement>("[data-waline-mount]");
    if (!mount) return;
    setStatus(root, "loading");
    addServerHint();

    try {
      const { init } = await loadWalineClient();
      if (version !== navigationVersion || !root.isConnected) return;
      walineInstance?.destroy();
      walineInstance = null;
      mount.replaceChildren();
      walineInstance = init({
        el: mount,
        serverURL: "https://tencent.n2g.cn/",
        path: normalizedPath(),
        lang: "zh-CN",
        locale: {
          placeholder: "期待你的真知灼见~",
          sofa: "快来做第一个评论的人吧~",
          submit: "提交",
          reply: "回复",
          cancelReply: "取消回复",
          comment: "评论",
          refresh: "刷新",
          more: "加载更多...",
          preview: "预览",
          emoji: "表情",
          uploadImage: "上传图片",
        },
        emoji: ["https://unpkg.com/@waline/emojis@1.2.0/qq"],
        dark: 'html[data-theme="dark"]',
        meta: ["nick", "mail", "link"],
        requiredMeta: ["nick"],
        pageSize: 10,
        wordLimit: [0, 1000],
        imageUploader: false,
        highlighter: true,
        texRenderer: false,
        commentSorting: "latest",
        search: false,
        reaction: false,
        login: "disable",
      });
      if (!walineInstance) throw new Error("Waline did not return an instance");
      setStatus(root, "ready");
    } catch (error) {
      if (version !== navigationVersion || !root.isConnected) return;
      console.error("Waline 初始化失败:", error);
      mount.replaceChildren();
      setStatus(root, "error");
    }
  }

  function initWaline() {
    navigationVersion += 1;
    const version = navigationVersion;
    commentsObserver?.disconnect();
    commentsObserver = null;
    walineInstance?.destroy();
    walineInstance = null;

    const root = document.querySelector<HTMLElement>("[data-waline-root]");
    if (!root) return;
    root.dataset.state = "idle";
    if (root.dataset.retryReady !== "true") {
      root.dataset.retryReady = "true";
      root.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target.closest("[data-waline-retry]")) {
          root.dataset.state = "idle";
          void mountWaline(root, navigationVersion);
        }
      });
    }

    if (!("IntersectionObserver" in window)) {
      void mountWaline(root, version);
      return;
    }
    commentsObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        commentsObserver?.disconnect();
        commentsObserver = null;
        void mountWaline(root, version);
      },
      { rootMargin: "1000px 0px", threshold: 0.01 },
    );
    commentsObserver.observe(root);
  }

  initWaline();
  document.addEventListener("astro:page-load", initWaline);
  document.addEventListener("astro:before-swap", () => {
    navigationVersion += 1;
    commentsObserver?.disconnect();
    commentsObserver = null;
    walineInstance?.destroy();
    walineInstance = null;
  });
</script>

<style>
  .waline-container {
    min-height: 8rem;
    margin: 2em 0;
    padding: 1em 0;
    border-top: 1px solid var(--color-border-subtle);
  }
</style>
