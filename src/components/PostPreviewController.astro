<script>
  function syncPreviewReadMore() {
    document
      .querySelectorAll<HTMLElement>("[data-post-preview]")
      .forEach((preview) => {
        const card = preview.closest<HTMLElement>("[data-preview-card]");
        const readMore = card?.querySelector<HTMLElement>(
          "[data-preview-read-more]",
        );

        if (!readMore) return;
        const isTruncated = preview.scrollHeight > preview.clientHeight + 1;
        preview.toggleAttribute("data-preview-truncated", isTruncated);
        readMore.hidden = !isTruncated;
      });
  }

  let previewFrame = 0;
  function schedulePreviewCheck() {
    cancelAnimationFrame(previewFrame);
    previewFrame = requestAnimationFrame(syncPreviewReadMore);
  }

  schedulePreviewCheck();
  document.addEventListener("astro:page-load", schedulePreviewCheck);
  window.addEventListener("resize", schedulePreviewCheck, { passive: true });
</script>
