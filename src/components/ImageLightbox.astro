<dialog class="image-lightbox" aria-label="图片查看器">
  <button class="lightbox-close" type="button" aria-label="关闭图片查看器"
    >×</button
  >
  <button
    class="lightbox-nav lightbox-prev"
    type="button"
    aria-label="上一张图片">‹</button
  >
  <figure class="lightbox-figure">
    <img class="lightbox-image" alt="" />
    <figcaption class="lightbox-caption">
      <span data-lightbox-title></span>
      <span data-lightbox-counter aria-live="polite"></span>
    </figcaption>
  </figure>
  <button
    class="lightbox-nav lightbox-next"
    type="button"
    aria-label="下一张图片">›</button
  >
</dialog>

<script>
  function initImageLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>(".image-lightbox");
    if (!dialog || dialog.dataset.lightboxReady === "true") return;
    const images = Array.from(
      document.querySelectorAll<HTMLImageElement>(
        "#article :is(.photo-single, .photo-gallery) img:not(.inline)",
      ),
    );
    if (!images.length) return;

    const viewer = dialog.querySelector<HTMLImageElement>(".lightbox-image");
    const title = dialog.querySelector<HTMLElement>("[data-lightbox-title]");
    const counter = dialog.querySelector<HTMLElement>(
      "[data-lightbox-counter]",
    );
    const closeButton =
      dialog.querySelector<HTMLButtonElement>(".lightbox-close");
    const previousButton =
      dialog.querySelector<HTMLButtonElement>(".lightbox-prev");
    const nextButton =
      dialog.querySelector<HTMLButtonElement>(".lightbox-next");
    if (
      !viewer ||
      !title ||
      !counter ||
      !closeButton ||
      !previousButton ||
      !nextButton
    )
      return;

    dialog.dataset.lightboxReady = "true";
    let currentIndex = 0;

    const render = (index: number) => {
      currentIndex = (index + images.length) % images.length;
      const source = images[currentIndex];
      const caption = source
        .closest("figure")
        ?.querySelector("figcaption")
        ?.textContent?.trim();
      viewer.src = source.dataset.fullSrc || source.currentSrc || source.src;
      viewer.alt = source.alt;
      title.textContent = caption || source.alt;
      counter.textContent =
        images.length > 1 ? `${currentIndex + 1} / ${images.length}` : "";
    };

    const open = (index: number) => {
      render(index);
      dialog.showModal();
      document.documentElement.classList.add("lightbox-open");
      closeButton.focus({ preventScroll: true });
    };

    images.forEach((image, index) => {
      image.addEventListener("click", (event) => {
        event.preventDefault();
        open(index);
      });
      image.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open(index);
        }
      });
    });

    closeButton.addEventListener("click", () => dialog.close());
    previousButton.addEventListener("click", () => render(currentIndex - 1));
    nextButton.addEventListener("click", () => render(currentIndex + 1));
    previousButton.hidden = images.length < 2;
    nextButton.hidden = images.length < 2;

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        dialog.close();
      } else if (event.key === "ArrowLeft" && images.length > 1) {
        event.preventDefault();
        render(currentIndex - 1);
      } else if (event.key === "ArrowRight" && images.length > 1) {
        event.preventDefault();
        render(currentIndex + 1);
      }
    });
    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("lightbox-open");
      viewer.removeAttribute("src");
    });
  }

  initImageLightbox();
  document.addEventListener("astro:page-load", initImageLightbox);
  document.addEventListener("astro:before-swap", () => {
    const dialog = document.querySelector<HTMLDialogElement>(
      ".image-lightbox[open]",
    );
    dialog?.close();
  });
</script>

<style>
  :global(html.lightbox-open) {
    overflow: hidden;
  }

  .image-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(3.5rem, 7vw, 5rem) clamp(1rem, 4vw, 3rem) 1.25rem;
    border: 0;
    color: #edf3ef;
    background: rgb(12 17 15 / 96%);
  }

  .image-lightbox[open] {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
  }

  .image-lightbox::backdrop {
    background: rgb(8 12 10 / 82%);
    backdrop-filter: blur(8px);
  }

  .lightbox-figure {
    display: grid;
    min-width: 0;
    height: 100%;
    align-content: center;
    margin: 0;
  }

  .lightbox-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 8.5rem);
    margin: auto;
    border-radius: var(--radius-md);
    object-fit: contain;
    box-shadow: 0 24px 70px rgb(0 0 0 / 38%);
  }

  .lightbox-caption {
    display: flex;
    min-height: 2rem;
    align-items: baseline;
    justify-content: center;
    gap: 1rem;
    padding-top: 0.75rem;
    color: #b8c5bd;
    font-size: 0.82rem;
    line-height: 1.5;
    text-align: center;
  }

  [data-lightbox-counter] {
    color: #7f9187;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .lightbox-close,
  .lightbox-nav {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(223 238 229 / 16%);
    border-radius: var(--radius-pill);
    color: #edf3ef;
    background: rgb(32 44 38 / 76%);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgb(48 68 57 / 92%);
    transform: translateY(-1px);
  }

  .lightbox-close {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
    font-size: 1.65rem;
    line-height: 1;
  }

  .lightbox-nav {
    font-size: 2rem;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .image-lightbox {
      padding-inline: 0.75rem;
    }

    .image-lightbox[open] {
      grid-template-columns: 1fr;
    }

    .lightbox-nav {
      position: absolute;
      z-index: 2;
      bottom: 1rem;
    }

    .lightbox-prev {
      left: 1rem;
    }

    .lightbox-next {
      right: 1rem;
    }

    .lightbox-image {
      max-height: calc(100dvh - 10rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-close,
    .lightbox-nav {
      transition: none;
    }
  }
</style>
