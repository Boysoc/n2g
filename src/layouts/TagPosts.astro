---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Datetime from "@components/Datetime";
import Pagination from "@components/Pagination.astro";
import { slugifyStr } from "@utils/slugify";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  totalPosts: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, totalPosts, paginatedPosts, tag, tagName } =
  Astro.props;
---

<Layout title={`标签：${tagName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={["标签：", tagName]}
    titleTransition={tag}
    pageDesc={`${totalPosts} 篇文章`}
  >
    <ul class="tag-post-list">
      {
        paginatedPosts.map(({ data, id }) => (
          <li class="tag-post-item">
            <Datetime
              pubDatetime={data.pubDatetime}
              modDatetime={data.modDatetime}
              className="tag-post-date"
            />
            <a
              class="tag-post-link"
              href={`/posts/${id}/`}
              aria-label={`阅读文章：${data.title}`}
            >
              <h2 style={{ viewTransitionName: slugifyStr(id) }}>
                {data.title}
              </h2>
              <span class="tag-post-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    pageBaseUrl={`/tags/${tag}`}
    prevUrl={`/tags/${tag}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }/`}
    nextUrl={`/tags/${tag}/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
