---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import PostPreviewController from "@components/PostPreviewController.astro";
import getPostPreview from "@utils/getPostPreview";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout title={`文章 | ${SITE.title}`}>
  <Header activeNav="home" />
  <div>
    <Main>
      <ul class="card-ul">
        {
          paginatedPosts.map(({ data, id, body }) => {
            const preview = getPostPreview(body ?? "");
            return (
              <Card
                href={`/posts/${id}/`}
                slug={id}
                frontmatter={data}
                variant="preview"
                previewMedia={preview.media}
                previewContent={preview.content}
              />
            );
          })
        }
      </ul>
    </Main>

    <Pagination
      {currentPage}
      {totalPages}
      prevUrl={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
      nextUrl={`/posts/${currentPage + 1}/`}
    />
  </div>

  <PostPreviewController />
  <Footer noMarginTop={totalPages > 1} />
</Layout>
