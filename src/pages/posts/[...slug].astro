---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { SITE } from '../../data/site';
import {
  formatPostDate,
  getPostPath,
  getPostPresentation,
  getPublishedPosts,
  type PostEntry,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      olderPost: posts[index + 1] ?? null,
      newerPost: posts[index - 1] ?? null,
    },
  }));
}

interface Props {
  post: PostEntry;
  olderPost: PostEntry | null;
  newerPost: PostEntry | null;
}

const { post, olderPost, newerPost } = Astro.props;
const { Content } = await render(post);
const publishedTime = post.data.pubDate.toISOString();
const { description, heroImage, heroImageAlt } = getPostPresentation(post);
const heroImageUrl = typeof heroImage === 'string' ? heroImage : heroImage?.src;
---

<BaseLayout
  title={`${post.data.title} | ${SITE.title}`}
  description={description}
  pageType="post"
  publishedTime={publishedTime}
  heroImage={heroImageUrl}
  heroImageAlt={heroImageAlt}
>
  <div slot="before-header" class="progress-container" aria-hidden="true">
    <div class="progress-bar" id="scroll-progress"></div>
  </div>

  {heroImage && (
    <figure class="post-hero">
      {typeof heroImage === 'string' ? (
        <img
          src={heroImage}
          alt={heroImageAlt}
          width={post.data.heroImageWidth}
          height={post.data.heroImageHeight}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <Image
          src={heroImage}
          alt={heroImageAlt}
          widths={[640, 960, 1280]}
          sizes="100vw"
          layout="full-width"
          quality={82}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )}
    </figure>
  )}

  <div class:list={['post-surface', { 'has-hero': Boolean(heroImage) }]}>
    <header class="post-header">
      <time class="post-date" datetime={publishedTime}>{formatPostDate(post.data.pubDate)}</time>
      <h1 class="post-title" transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
    </header>

    <article id="article" class="post-content">
      <Content />
    </article>

    <Comments />

    {(olderPost || newerPost) && (
      <nav class="related-post" aria-label="相邻文章">
        <div class="prev-post">
          {olderPost && (
            <a href={getPostPath(olderPost)} class="related-link" rel="prev">
              <span class="related-label">上一篇</span>
              <span class="related-title">{olderPost.data.title}</span>
            </a>
          )}
        </div>
        <div class="next-post">
          {newerPost && (
            <a href={getPostPath(newerPost)} class="related-link" rel="next">
              <span class="related-label">下一篇</span>
              <span class="related-title">{newerPost.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const enhanceArticle = () => {
      const article = document.querySelector('#article');
      if (!article) return;

      article.querySelectorAll('h2, h3, h4, h5, h6').forEach((heading) => {
        if (!heading.id || heading.closest('[data-footnotes]') || heading.querySelector(':scope > .heading-link')) return;
        const link = document.createElement('a');
        link.textContent = '¶';
        link.className = 'heading-link';
        link.href = `#${heading.id}`;
        link.setAttribute('aria-label', `链接到“${heading.textContent?.trim() || '此章节'}”`);
        heading.append(link);
      });

      article.querySelectorAll('img').forEach((image) => {
        if (!image.hasAttribute('loading')) image.loading = 'lazy';
        if (!image.hasAttribute('decoding')) image.decoding = 'async';
      });

      if (article.dataset.photoLightboxReady !== 'true') {
        const galleryImages = Array.from(article.querySelectorAll('.photo-gallery img'));

        if (galleryImages.length > 0) {
          article.dataset.photoLightboxReady = 'true';

          const controller = new AbortController();
          const { signal } = controller;
          const items = galleryImages.map((image) => {
            let trigger = image.closest('a');

            if (!trigger) {
              const button = document.createElement('button');
              const visual = image.parentElement?.tagName === 'PICTURE' ? image.parentElement : image;
              button.type = 'button';
              button.className = 'photo-gallery__trigger';
              visual.parentNode?.insertBefore(button, visual);
              button.append(visual);
              trigger = button;
            }

            trigger.classList.add('photo-gallery__trigger');
            trigger.setAttribute('aria-label', image.alt ? `查看大图“${image.alt}”` : '查看大图');

            return {
              image,
              trigger,
              src: trigger instanceof HTMLAnchorElement ? trigger.href : image.src,
              alt: image.alt || '图片',
            };
          });

          const overlay = document.createElement('div');
          const backdrop = document.createElement('div');
          const stage = document.createElement('div');
          const viewer = document.createElement('img');
          const status = document.createElement('p');
          const makeControl = (className, label, text) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = `image-lightbox__control ${className}`;
            button.setAttribute('aria-label', label);
            button.textContent = text;
            return button;
          };
          const previous = makeControl('image-lightbox__previous', '上一张', '‹');
          const next = makeControl('image-lightbox__next', '下一张', '›');
          const close = makeControl('image-lightbox__close', '关闭图片', '×');

          overlay.className = 'image-lightbox';
          overlay.hidden = true;
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-modal', 'true');
          overlay.setAttribute('aria-label', '图片查看器');
          backdrop.className = 'image-lightbox__backdrop';
          backdrop.setAttribute('aria-hidden', 'true');
          stage.className = 'image-lightbox__stage';
          viewer.className = 'image-lightbox__image';
          viewer.decoding = 'async';
          status.className = 'image-lightbox__status';
          status.setAttribute('aria-live', 'polite');
          stage.append(viewer);
          overlay.append(backdrop, stage, previous, next, close, status);
          document.body.append(overlay);

          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const motionDuration = reducedMotion ? 0 : 160;
          const switchDuration = reducedMotion ? 0 : 130;
          let activeIndex = 0;
          let isOpen = false;
          let isBusy = false;
          let returnFocus = null;

          const waitForImage = async (item) => {
            viewer.src = item.src;
            viewer.alt = item.alt;
            try {
              await viewer.decode();
            } catch {
              // The browser still displays the fallback image if decoding cannot be awaited.
            }
          };

          const layoutViewer = (item) => {
            const bounds = stage.getBoundingClientRect();
            const naturalWidth = viewer.naturalWidth || item.image.naturalWidth || bounds.width;
            const naturalHeight = viewer.naturalHeight || item.image.naturalHeight || bounds.height;
            const scale = Math.min(bounds.width / naturalWidth, bounds.height / naturalHeight, 1);
            const width = Math.max(1, naturalWidth * scale);
            const height = Math.max(1, naturalHeight * scale);
            const left = bounds.left + ((bounds.width - width) / 2);
            const top = bounds.top + ((bounds.height - height) / 2);

            viewer.style.left = `${left}px`;
            viewer.style.top = `${top}px`;
            viewer.style.width = `${width}px`;
            viewer.style.height = `${height}px`;

            return { left, top, width, height };
          };

          const runAnimation = async (keyframes, duration) => {
            if (duration === 0) return;
            const animation = viewer.animate(keyframes, {
              duration,
              easing: 'ease-out',
              fill: 'both',
            });
            try {
              await animation.finished;
            } catch {
              // An interrupted animation can safely snap to its final CSS state.
            }
            animation.cancel();
          };

          const updateStatus = () => {
            const item = items[activeIndex];
            status.textContent = `${activeIndex + 1} / ${items.length} · ${item.alt}`;
          };

          const openAt = async (index) => {
            if (isOpen || isBusy) return;
            isBusy = true;
            isOpen = true;
            activeIndex = index;
            returnFocus = document.activeElement;

            const item = items[activeIndex];
            const sourceRect = item.image.getBoundingClientRect();
            overlay.hidden = false;
            await waitForImage(item);
            const targetRect = layoutViewer(item);
            item.image.classList.add('is-lightbox-source');
            updateStatus();
            previous.hidden = items.length < 2;
            next.hidden = items.length < 2;
            viewer.classList.add('is-ready');
            document.documentElement.classList.add('lightbox-open');
            overlay.classList.add('is-open');

            const translateX = sourceRect.left - targetRect.left;
            const translateY = sourceRect.top - targetRect.top;
            const scaleX = sourceRect.width / targetRect.width;
            const scaleY = sourceRect.height / targetRect.height;
            await runAnimation([
              {
                opacity: 0.45,
                transform: `translate(${translateX}px, ${translateY}px) scale(${scaleX}, ${scaleY})`,
              },
              { opacity: 1, transform: 'translate(0, 0) scale(1, 1)' },
            ], motionDuration);

            isBusy = false;
            close.focus({ preventScroll: true });
          };

          const closeLightbox = async () => {
            if (!isOpen || isBusy) return;
            isBusy = true;
            const item = items[activeIndex];
            const viewerRect = viewer.getBoundingClientRect();
            const sourceRect = item.image.getBoundingClientRect();
            const translateX = sourceRect.left - viewerRect.left;
            const translateY = sourceRect.top - viewerRect.top;
            const scaleX = sourceRect.width / viewerRect.width;
            const scaleY = sourceRect.height / viewerRect.height;

            overlay.classList.remove('is-open');
            document.documentElement.classList.remove('lightbox-open');
            await runAnimation([
              { opacity: 1, transform: 'translate(0, 0) scale(1, 1)' },
              {
                opacity: 0.35,
                transform: `translate(${translateX}px, ${translateY}px) scale(${scaleX}, ${scaleY})`,
              },
            ], motionDuration);

            viewer.classList.remove('is-ready');
            item.image.classList.remove('is-lightbox-source');
            overlay.hidden = true;
            isOpen = false;
            isBusy = false;
            if (returnFocus instanceof HTMLElement && returnFocus.isConnected) {
              returnFocus.focus({ preventScroll: true });
            }
          };

          const switchTo = async (direction) => {
            if (!isOpen || isBusy || items.length < 2) return;
            isBusy = true;
            const oldItem = items[activeIndex];

            await runAnimation([
              { opacity: 1, transform: 'translateX(0)' },
              { opacity: 0, transform: `translateX(${-direction * 1.25}rem)` },
            ], switchDuration);
            viewer.classList.remove('is-ready');
            oldItem.image.classList.remove('is-lightbox-source');

            activeIndex = (activeIndex + direction + items.length) % items.length;
            const newItem = items[activeIndex];
            newItem.image.classList.add('is-lightbox-source');
            await waitForImage(newItem);
            layoutViewer(newItem);
            updateStatus();
            viewer.classList.add('is-ready');
            await runAnimation([
              { opacity: 0, transform: `translateX(${direction * 1.25}rem)` },
              { opacity: 1, transform: 'translateX(0)' },
            ], switchDuration);
            isBusy = false;
          };

          items.forEach((item, index) => {
            item.trigger.addEventListener('click', (event) => {
              event.preventDefault();
              openAt(index);
            }, { signal });
          });

          previous.addEventListener('click', () => switchTo(-1), { signal });
          next.addEventListener('click', () => switchTo(1), { signal });
          close.addEventListener('click', closeLightbox, { signal });
          backdrop.addEventListener('click', closeLightbox, { signal });
          overlay.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              event.preventDefault();
              closeLightbox();
            } else if (event.key === 'ArrowLeft') {
              event.preventDefault();
              switchTo(-1);
            } else if (event.key === 'ArrowRight') {
              event.preventDefault();
              switchTo(1);
            } else if (event.key === 'Tab') {
              const controls = [previous, next, close].filter((control) => !control.hidden);
              const current = controls.indexOf(document.activeElement);
              if (event.shiftKey && current <= 0) {
                event.preventDefault();
                controls.at(-1)?.focus();
              } else if (!event.shiftKey && current === controls.length - 1) {
                event.preventDefault();
                controls[0]?.focus();
              }
            }
          }, { signal });
          window.addEventListener('resize', () => {
            if (isOpen && !isBusy) layoutViewer(items[activeIndex]);
          }, { signal });
          document.addEventListener('astro:before-swap', () => {
            controller.abort();
            document.documentElement.classList.remove('lightbox-open');
            overlay.remove();
          }, { once: true });
        }
      }

      article.querySelectorAll('[data-douyin-embed]').forEach((embed) => {
        if (!(embed instanceof HTMLElement) || embed.dataset.douyinReady === 'true') return;

        const frame = embed.querySelector('[data-douyin-frame]');
        const button = embed.querySelector('[data-douyin-load]');
        const videoId = embed.dataset.videoId ?? '';
        if (!(frame instanceof HTMLElement) || !(button instanceof HTMLButtonElement) || !/^\d{10,24}$/.test(videoId)) return;

        embed.dataset.douyinReady = 'true';
        button.addEventListener('click', () => {
          const iframe = document.createElement('iframe');
          iframe.src = `https://open.douyin.com/player/video?vid=${videoId}&autoplay=1`;
          iframe.title = embed.dataset.videoTitle || '抖音视频播放器';
          iframe.loading = 'eager';
          iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
          iframe.allowFullscreen = true;
          iframe.setAttribute('scrolling', 'no');
          embed.classList.add('douyin-embed--loaded');
          frame.replaceChildren(iframe);

          const mobilePlayerWidth = 324;
          const mobilePlayerHeight = 720;
          const resizeMobilePlayer = () => {
            if (!window.matchMedia('(max-width: 719px)').matches) {
              embed.style.removeProperty('--douyin-mobile-player-height');
              iframe.style.removeProperty('width');
              iframe.style.removeProperty('height');
              iframe.style.removeProperty('transform');
              iframe.style.removeProperty('transform-origin');
              return;
            }

            const scale = Math.min(1, frame.clientWidth / mobilePlayerWidth);
            embed.style.setProperty('--douyin-mobile-player-height', `${Math.ceil(mobilePlayerHeight * scale) + 2}px`);
            iframe.style.height = `${mobilePlayerHeight}px`;

            if (scale < 1) {
              iframe.style.width = `${mobilePlayerWidth}px`;
              iframe.style.transform = `scale(${scale})`;
              iframe.style.transformOrigin = 'top left';
            } else {
              iframe.style.removeProperty('width');
              iframe.style.removeProperty('transform');
              iframe.style.removeProperty('transform-origin');
            }
          };

          resizeMobilePlayer();
          new ResizeObserver(resizeMobilePlayer).observe(frame);
        }, { once: true });
      });

      article.querySelectorAll('pre').forEach((codeBlock) => {
        if (codeBlock.parentElement?.classList.contains('code-block-wrapper')) return;

        const wrapper = document.createElement('div');
        const button = document.createElement('button');
        wrapper.className = 'code-block-wrapper';
        button.className = 'copy-code';
        button.type = 'button';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', '复制代码');

        codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
        wrapper.append(codeBlock, button);

        button.addEventListener('click', async () => {
          const code = codeBlock.querySelector('code')?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(code);
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Failed';
          }
          window.setTimeout(() => { button.textContent = 'Copy'; }, 700);
        });
      });
    };

    if (!window.__n2gArticleBound) {
      window.__n2gArticleBound = true;
      document.addEventListener('astro:page-load', enhanceArticle);
    }
    enhanceArticle();
  })();
</script>
