---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { getPostPath, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();

// 按年份分组
const yearMap: Record<string, typeof posts> = {};
for (const post of posts) {
  const year = post.data.pubDate.getFullYear().toString();
  if (!yearMap[year]) yearMap[year] = [];
  yearMap[year].push(post);
}
const years = Object.keys(yearMap).sort((a, b) => Number(b) - Number(a));

function formatArchiveDate(date: Date) {
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${m}.${d}`;
}
---

<BaseLayout title={`归档 | ${SITE.title}`} description={`按年份浏览 ${SITE.title} 发布的全部文章。`} pageType="archive">
  <section class="page archive-page">
    <header class="archive-header">
      <p class="page-kicker">Archive</p>
      <h1 class="post-title">归档</h1>
    </header>
    <div class="archive-content">
      {years.map((year) => (
        <div class="year-section">
          <div class="year-heading">
            <h2 class="year-title">{year}</h2>
          </div>
          <ol class="posts-list">
            {yearMap[year].map((post) => (
              <li class="posts-list-item">
                <time class="posts-list-meta" datetime={post.data.pubDate.toISOString()}>
                  {formatArchiveDate(post.data.pubDate)}
                </time>
                <a class="posts-list-name" href={getPostPath(post)}>{post.data.title}</a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
