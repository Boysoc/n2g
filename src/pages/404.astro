---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title={`页面未找到 | ${SITE.title}`} description="你访问的页面不存在或已经移动。" pageType="not-found">
  <section class="not-found-page" aria-labelledby="not-found-title">
    <p class="page-kicker">404</p>
    <h1 id="not-found-title" class="post-title">这页没有留下来</h1>
    <p>链接可能已经失效，也可能只是地址里多了一个字符。</p>
    <div class="not-found-actions">
      <a class="primary-link" href="/">返回首页</a>
      <a href="/archives/">浏览归档</a>
    </div>
  </section>
</BaseLayout>
