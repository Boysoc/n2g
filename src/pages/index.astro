---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../data/site';
import { getPublishedPosts, POSTS_PER_PAGE } from '../utils/posts';

const allPosts = await getPublishedPosts();

// 统计正文纯文字数（去除 HTML 标签和 Markdown 语法符号）
function countWords(body: string): number {
  return body
    .replace(/<[^>]+>/g, '')    // 去 HTML 标签
    .replace(/[#*>\-\[\]()!`]/g, '')  // 去 Markdown 语法符号
    .replace(/\s+/g, '')        // 去空白
    .length;
}

const totalChars = allPosts.reduce((sum, p) => sum + countWords(p.body || ''), 0);
const totalWords = totalChars.toLocaleString();

const displayPosts = allPosts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = allPosts.length > POSTS_PER_PAGE;
---

<BaseLayout title={SITE.title} description={SITE.description} pageType="home">
  <section slot="after-header" class="home-intro" aria-labelledby="home-intro-title">
    <div class="home-intro-inner">
      <h1 id="home-intro-title">{SITE.slogan}</h1>
      <p>已写下 <span>{totalWords}</span> 字</p>
    </div>
  </section>

  <section id="recent-posts">
    <ul class="card-ul post-grid featured-post-grid">
      {displayPosts.map((post) => <PostCard post={post} />)}
    </ul>
  </section>

  {hasMorePosts && (
    <nav slot="after-main" class="content all-posts-btn-wrapper" aria-label="更多文章">
      <a href="/posts/2/">更多文章 <span class="tri-right" aria-hidden="true"></span></a>
    </nav>
  )}
</BaseLayout>
