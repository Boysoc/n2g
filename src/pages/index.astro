---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Card from "@components/Card";
import PostPreviewController from "@components/PostPreviewController.astro";
import getSortedPosts from "@utils/getSortedPosts";
import getPostPreview from "@utils/getPostPreview";
import { SITE } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts, { renderContent: false });
const recentPosts = sortedPosts.slice(0, SITE.postPerPage).map((post) => ({
  ...post,
  preview: getPostPreview(post.body ?? ""),
}));
---

<Layout>
  <Header activeNav="home" />
  <main id="main-content" class="content">
    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <ul class="card-ul">
            {recentPosts.map(({ data, id, preview }) => (
              <Card
                slug={id}
                href={`/posts/${id}/`}
                frontmatter={data}
                secHeading={false}
                variant="preview"
                previewMedia={preview.media}
                previewContent={preview.content}
              />
            ))}
          </ul>
        </section>
      )
    }
    {
      sortedPosts.length > SITE.postPerPage && (
        <div class="all-posts-btn-wrapper">
          <LinkButton href="/posts/2/">更多文章 &gt;</LinkButton>
        </div>
      )
    }
  </main>
  <PostPreviewController />
  <Footer />
</Layout>
