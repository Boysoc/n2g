---
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from '../components/Comments.astro';
import { friendLinks } from '../data/friends';
import { SITE } from '../data/site';

const links = friendLinks.map((friend) => {
  const url = new URL(friend.url);

  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
    throw new Error(`友情链接“${friend.name}”必须使用 http 或 https 地址。`);
  }

  return {
    ...friend,
    host: url.hostname.replace(/^www\./, ''),
    mark: friend.name.trim().charAt(0),
    badge: friend.organization ? '组织' : friend.inactive ? '旧址' : friend.verified ? '互链' : undefined,
  };
});

const verifiedLinks = links.filter((link) => link.verified && !link.inactive && !link.organization);
const otherLinks = links.filter((link) => !link.verified && !link.inactive && !link.organization);
const organizationLinks = links.filter((link) => link.organization);
const inactiveLinks = links.filter((link) => link.inactive && !link.organization);
const activeLinkCount = links.filter((link) => !link.inactive).length;
const moreGroups = [
  { id: 'more-neighbors', title: '更多邻居', kicker: 'Neighbors', links: otherLinks },
  { id: 'blog-organizations', title: '博客组织', kicker: 'Communities', links: organizationLinks },
  { id: 'old-links', title: '旧日链接', kicker: 'Archive', links: inactiveLinks },
].filter((group) => group.links.length > 0);
const moreLinkCount = moreGroups.reduce((count, group) => count + group.links.length, 0);
const siteLogoUrl = new URL('/logo.webp', SITE.url).href;
const siteRssUrl = new URL('/rss.xml', SITE.url).href;
---

<BaseLayout
  title={`友情链接 | ${SITE.title}`}
  description={`${SITE.title} 的友情链接与独立博客邻居。`}
  pageType="friends"
>
  <section class="page friends-page">
    <header class="friends-header">
      <p class="page-kicker">Blogroll</p>
      <h1 class="post-title">友情链接</h1>
      <p class="friends-intro">互联网上的有趣灵魂，与他们为邻。</p>
      <p class="friends-total">当前收录 <span>{activeLinkCount}</span> 个有效站点</p>
    </header>

    <section class="friends-list-section" aria-labelledby="friends-list-title">
      <div class="friends-section-heading">
        <h2 id="friends-list-title">互链邻居</h2>
        <span>{verifiedLinks.length.toString().padStart(2, '0')}</span>
      </div>

      <ul class="friends-grid">
        {verifiedLinks.map((friend) => (
          <li>
            <a
              class="friend-card"
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              title={friend.tooltip || friend.description || friend.name}
            >
              <span class:list={['friend-mark', { 'has-logo': friend.logo }]} aria-hidden="true">
                {friend.logo && (
                  <img
                    src={friend.logo}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    data-friend-logo
                  />
                )}
                <span class="friend-mark-fallback">{friend.mark}</span>
              </span>
              <span class="friend-copy">
                <span class="friend-name-row">
                  <span class="friend-name">{friend.name}</span>
                  {friend.badge && <span class="friend-badge">{friend.badge}</span>}
                </span>
                <span class="friend-description">{friend.description || '暂无简介'}</span>
                <span class="friend-host">{friend.host}</span>
              </span>
              <svg class="friend-arrow" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8"></path>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {moreGroups.length > 0 && (
      <details class="friends-more">
        <summary>
          <span>更多链接</span>
          <span class="friends-more-count">{moreLinkCount.toString().padStart(2, '0')}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"></path></svg>
        </summary>

        <div class="friends-more-content">
          {moreGroups.map((group) => (
            <section class="friends-subsection" aria-labelledby={group.id}>
              <div class="friends-section-heading">
                <div>
                  <p class="page-kicker">{group.kicker}</p>
                  <h2 id={group.id}>{group.title}</h2>
                </div>
                <span>{group.links.length.toString().padStart(2, '0')}</span>
              </div>

              <ul class="friends-grid">
                {group.links.map((friend) => (
                  <li>
                    <a
                      class:list={['friend-card', 'is-compact', { 'is-inactive': friend.inactive }]}
                      href={friend.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={friend.tooltip || friend.description || friend.name}
                    >
                      <span class="friend-copy">
                        <span class="friend-name-row">
                          <span class="friend-name">{friend.name}</span>
                          {friend.badge && <span class="friend-badge">{friend.badge}</span>}
                        </span>
                        <span class="friend-description">{friend.description || '暂无简介'}</span>
                        <span class="friend-host">{friend.host}</span>
                      </span>
                      <svg class="friend-arrow" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 17 17 7M9 7h8v8"></path>
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </details>
    )}

    <section class="friend-exchange" aria-labelledby="friend-exchange-title">
      <div class="friend-exchange-heading">
        <p class="page-kicker">Exchange</p>
        <h2 id="friend-exchange-title">交换友链</h2>
      </div>
      <p class="friend-exchange-copy">如果你也在持续维护自己的博客，欢迎友链。无需客套，附上站点名称、地址和一句简短介绍即可。</p>

      <div class="exchange-card" id="exchange-card">
        <div class="exchange-card-info">
          <div class="exchange-row">
            <span class="exchange-label">名称</span>
            <span class="exchange-value">{SITE.title}</span>
          </div>
          <div class="exchange-row">
            <span class="exchange-label">网址</span>
            <span class="exchange-value exchange-link">{SITE.url}</span>
          </div>
          <div class="exchange-row">
            <span class="exchange-label">描述</span>
            <span class="exchange-value">{SITE.slogan}</span>
          </div>
          <div class="exchange-row">
            <span class="exchange-label">Logo</span>
            <span class="exchange-value exchange-link">{siteLogoUrl}</span>
          </div>
          <div class="exchange-row">
            <span class="exchange-label">RSS</span>
            <span class="exchange-value exchange-link">{siteRssUrl}</span>
          </div>
        </div>
        <button class="exchange-copy-btn" id="exchange-copy-btn" type="button">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>复制</span>
        </button>
      </div>
    </section>

    <Comments />
  </section>
</BaseLayout>

<script>
  const initFriendLogos = () => {
    document.querySelectorAll<HTMLImageElement>('[data-friend-logo]').forEach((logo) => {
      if (logo.dataset.fallbackReady === 'true') return;
      logo.dataset.fallbackReady = 'true';

      const showFallback = () => logo.closest('.friend-mark')?.classList.add('is-missing');
      logo.addEventListener('error', showFallback, { once: true });
      if (logo.complete && logo.naturalWidth === 0) showFallback();
    });
  };

  initFriendLogos();
  document.addEventListener('astro:page-load', initFriendLogos);

  const copyBtn = document.getElementById('exchange-copy-btn');
  copyBtn?.addEventListener('click', async () => {
    const card = document.getElementById('exchange-card');
    if (!card) return;
    const rows = card.querySelectorAll('.exchange-row');
    const text = Array.from(rows).map((row) => {
      const label = row.querySelector('.exchange-label')?.textContent || '';
      const value = row.querySelector('.exchange-value')?.textContent || '';
      return `${label}：${value}`;
    }).join('\n');
    try {
      await navigator.clipboard.writeText(text);
      const span = copyBtn.querySelector('span');
      if (span) {
        const orig = span.textContent;
        span.textContent = '已复制';
        setTimeout(() => { span.textContent = orig; }, 2000);
      }
    } catch (e) {}
  });
</script>
